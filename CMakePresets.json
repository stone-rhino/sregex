{
  "version": 2,
  "configurePresets": [
    {
      "name": "vcpkg",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "BUILD_BENCHES": "OFF",
        "BUILD_EXAMPLES": "OFF",
        "BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "debug",
      "inherits": "vcpkg",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_BENCHES": "ON",
        "BUILD_EXAMPLES": "ON",
        "BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "vcpkg",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_BENCHES": "OFF",
        "BUILD_EXAMPLES": "OFF",
        "BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release-with-debug-info",
      "inherits": "vcpkg",
      "binaryDir": "${sourceDir}/build/release-with-debug-info",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BUILD_BENCHES": "OFF",
        "BUILD_EXAMPLES": "OFF",
        "BUILD_TESTS": "ON"
      }
    },
    {
      "name": "benches",
      "inherits": "vcpkg",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_BENCHES": "ON",
        "BUILD_EXAMPLES": "OFF",
        "BUILD_TESTS": "ON"
      }
    }
  ]
}